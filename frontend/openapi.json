    "/audit/verify-file": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Verify File",
        "description": "Re-read the on-disk audit log and verify it from scratch.\n\nUnlike /verify (in-memory), this parses the actual JSON log file and\nrecomputes every hash over its current contents \u2014 so a hand-edit of the\nfile (the realistic insider-tamper scenario) is detected. This is the\nendpoint behind the \"verify log file\" demo.",
        "operationId": "verify_file_audit_verify_file_get",
        "parameters": [
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Verify File Audit Verify File Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit/tamper": {
      "post": {
        "tags": [
          "audit"
        ],
        "summary": "Tamper Chain",
        "description": "Tamper with an audit event to demonstrate chain breakage (Demo 6).\n\nMutates a single field on the event at the given index. The next\n/audit/verify call will report CHAIN TAMPERED with the break index.",
        "operationId": "tamper_chain_audit_tamper_post",
        "parameters": [
          {
            "name": "index",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 0,
              "title": "Index"
            }
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "resource_id",
              "title": "Field"
            }
          },
          {
            "name": "X-User-Id",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-User-Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Tamper Chain Audit Tamper Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
