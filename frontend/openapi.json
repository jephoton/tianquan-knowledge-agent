{
  "openapi": "3.1.0",
  "info": {
    "title": "VeriBrain API",
    "description": "Permission-aware enterprise knowledge agent.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/users": {
      "get": {
        "tags": [
          "meta"
        ],
        "summary": "Users",
        "description": "List seed users for the demo persona switcher.",
        "operationId": "users_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "additionalProperties": true,
                    "type": "object"
                  },
                  "type": "array",
                  "title": "Response Users Users Get"
                }
              }
            }
          }
        }
      }
    },
    "/query": {
      "post": {
        "tags": [
          "query"
        ],
        "summary": "Submit Query",
        "operationId": "submit_query_query_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueryResponseModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Query Audit",
        "operationId": "query_audit_audit_get",
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "User Id"
            }
          },
          {
            "name": "resource_contains",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Resource Contains"
            }
          },
          {
            "name": "query_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Query Id"
            }
          },
          {
            "name": "decision",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Decision"
            }
          },
          {
            "name": "action",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Action"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditQueryResponseModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/audit/verify": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Verify Chain",
        "description": "Report whether the audit chain is intact (tamper-evidence).",
        "operationId": "verify_chain_audit_verify_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Verify Chain Audit Verify Get"
                }
              }
            }
          }
        }
      }
    },
    "/admin/revoke": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Revoke",
        "operationId": "revoke_admin_revoke_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeGrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ACLChangeModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/admin/grant": {
      "post": {
        "tags": [
          "admin"
        ],
        "summary": "Grant",
        "operationId": "grant_admin_grant_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RevokeGrantRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ACLChangeModel"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ACLChangeModel": {
        "properties": {
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "previous_version": {
            "type": "integer",
            "title": "Previous Version"
          },
          "new_version": {
            "type": "integer",
            "title": "New Version"
          },
          "version_transition": {
            "type": "string",
            "title": "Version Transition"
          },
          "change": {
            "type": "string",
            "title": "Change"
          },
          "subject": {
            "type": "string",
            "title": "Subject"
          },
          "subject_kind": {
            "type": "string",
            "title": "Subject Kind"
          }
        },
        "type": "object",
        "required": [
          "resource_id",
          "previous_version",
          "new_version",
          "version_transition",
          "change",
          "subject",
          "subject_kind"
        ],
        "title": "ACLChangeModel"
      },
      "AuditEventModel": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "decision": {
            "type": "string",
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "acl_version": {
            "type": "integer",
            "title": "Acl Version"
          },
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          },
          "previous_hash": {
            "type": "string",
            "title": "Previous Hash"
          },
          "event_hash": {
            "type": "string",
            "title": "Event Hash"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "timestamp",
          "user_id",
          "query_id",
          "resource_id",
          "action",
          "decision",
          "reason",
          "acl_version",
          "policy_version",
          "previous_hash",
          "event_hash"
        ],
        "title": "AuditEventModel"
      },
      "AuditQueryResponseModel": {
        "properties": {
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "allow_count": {
            "type": "integer",
            "title": "Allow Count"
          },
          "deny_count": {
            "type": "integer",
            "title": "Deny Count"
          },
          "chain_valid": {
            "type": "boolean",
            "title": "Chain Valid"
          },
          "chain_status": {
            "type": "string",
            "title": "Chain Status"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/AuditEventModel"
            },
            "type": "array",
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "count",
          "allow_count",
          "deny_count",
          "chain_valid",
          "chain_status",
          "events"
        ],
        "title": "AuditQueryResponseModel"
      },
      "CitationModel": {
        "properties": {
          "marker": {
            "type": "string",
            "title": "Marker"
          },
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "marker",
          "resource_id",
          "source",
          "title"
        ],
        "title": "CitationModel"
      },
      "DecisionModel": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "resource_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resource Id"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "result": {
            "type": "string",
            "title": "Result"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          },
          "acl_version": {
            "type": "integer",
            "title": "Acl Version"
          },
          "policy_version": {
            "type": "integer",
            "title": "Policy Version"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "resource_id",
          "action",
          "result",
          "reason",
          "acl_version",
          "policy_version"
        ],
        "title": "DecisionModel"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QueryRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "Seed user id, e.g. 'alice'."
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "title": "Question"
          },
          "k": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "K",
            "description": "Candidate over-fetch size.",
            "default": 10
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "question"
        ],
        "title": "QueryRequest"
      },
      "QueryResponseModel": {
        "properties": {
          "query_id": {
            "type": "string",
            "title": "Query Id"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "no_access": {
            "type": "boolean",
            "title": "No Access"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationModel"
            },
            "type": "array",
            "title": "Citations"
          },
          "decisions": {
            "items": {
              "$ref": "#/components/schemas/DecisionModel"
            },
            "type": "array",
            "title": "Decisions"
          },
          "allow_count": {
            "type": "integer",
            "title": "Allow Count"
          },
          "deny_count": {
            "type": "integer",
            "title": "Deny Count"
          },
          "audit_chain_head": {
            "type": "string",
            "title": "Audit Chain Head"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "answer",
          "no_access",
          "citations",
          "decisions",
          "allow_count",
          "deny_count",
          "audit_chain_head"
        ],
        "title": "QueryResponseModel"
      },
      "RevokeGrantRequest": {
        "properties": {
          "resource_id": {
            "type": "string",
            "title": "Resource Id"
          },
          "subject": {
            "type": "string",
            "title": "Subject",
            "description": "A user_id or a role name."
          },
          "subject_kind": {
            "type": "string",
            "pattern": "^(user|role)$",
            "title": "Subject Kind",
            "default": "user"
          }
        },
        "type": "object",
        "required": [
          "resource_id",
          "subject"
        ],
        "title": "RevokeGrantRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}